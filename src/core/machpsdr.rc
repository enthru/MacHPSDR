/* machpsdr.rc — Windows resources: the .exe icon and its VERSIONINFO block.
 *
 * Compiled by windres from the Makefile's MINGW branch only (a `.rc` means
 * nothing to the macOS or Linux link), see the WIN_RES_OBJS rule there.
 *
 * The version is NOT a second copy of the one in src/core/version.c: both come
 * from the same GIT_VERSION the Makefile derives from `git describe`, passed in
 * here as MACHPSDR_VERSION (the string) and MACHPSDR_VERSION_NUM (the four
 * numbers VERSIONINFO insists on).  Defaults are supplied below so a hand
 * invocation of windres still compiles.
 *
 * GOTCHA: windres builds its preprocessor command line and runs it through a
 * shell, which eats the quotes of a -D that carries a quoted string — the
 * version therefore arrives as bare tokens and is quoted HERE with the usual
 * two-level stringiser.  Passing -D MACHPSDR_VERSION='"4.0"' looks right and
 * fails with `syntax error` on the VALUE line, naming nothing.
 */

#include <winver.h>

#ifndef MACHPSDR_VERSION
#define MACHPSDR_VERSION unknown
#endif
#ifndef MACHPSDR_VERSION_NUM
#define MACHPSDR_VERSION_NUM 0,0,0,0
#endif

#define RC_STR2(x) #x
#define RC_STR(x)  RC_STR2(x)

/* Lowest-numbered icon resource wins in Explorer, the taskbar and Alt-Tab.
   Built from assets/machpsdr_icon.png by tools/make_icon.py; windres finds it
   through the -I the Makefile passes. */
1 ICON "machpsdr.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    MACHPSDR_VERSION_NUM
PRODUCTVERSION MACHPSDR_VERSION_NUM
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    /* 040904B0 = US English, Unicode — matched by the Translation value below.
       A VERSIONINFO whose block name and Translation disagree reads as having
       no version at all in the properties dialog. */
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "MacHPSDR project"
      VALUE "FileDescription",  "MacHPSDR - SDR control for HPSDR hardware"
      VALUE "FileVersion",      RC_STR(MACHPSDR_VERSION)
      VALUE "InternalName",     "machpsdr"
      VALUE "OriginalFilename", "machpsdr.exe"
      VALUE "ProductName",      "MacHPSDR"
      VALUE "ProductVersion",   RC_STR(MACHPSDR_VERSION)
      VALUE "LegalCopyright",   "Copyright (C) 2018 John Melton G0ORX/N6LYT and contributors. Licensed under the GNU General Public License, version 2 or later; see LICENSE and NOTICE. This program comes with ABSOLUTELY NO WARRANTY."
      VALUE "Comments",         "A fork of LinHPSDR. Source: see NOTICE."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
