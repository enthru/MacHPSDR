# Build artifacts
*.o
*.d
*.dylib
*.so
*.a
machpsdr
# The MinGW build names the same binaries with a .exe suffix (see $(EXE) in the
# Makefile), so the extensionless entries here and below do not cover a Windows
# tree at all.
*.exe
MacHPSDR.app/
MacHPSDR.zip

# Debian package staging / generated packages (regenerated, never committed)
pkg/
*.deb

# Vendored WDSP (wdsp/) is now tracked as part of this repo; its own
# wdsp/.gitignore plus the globals above keep its build artifacts out.

# Test/scratch data
iq.wav
*.wav

# Screenshots / images
scr.jpg
screenshot.jpg

# macOS / editor / agent
.DS_Store
.claude/
.vscode/

# transient build artifact (entitlements for codesign)
machpsdr_entitlements.plist

# Internal roadmap (not for distribution)
doc/TODO-parity.md

# Claude Code project guidance (kept local, not distributed)
CLAUDE.md

